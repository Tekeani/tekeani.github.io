
---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
---

<!doctype html>
<html lang="fr">
  <head>
    <BaseHead
      title="Portfolio"
      description="Projets web et applications en cours de développement."
    />
  </head>
  <body>
    <Header />

    <main class="page-main">
      <section class="page-intro">
        <p class="eyebrow">/ projets.index</p>
        <h1>Du concret, <span class="gradient-text">pas à pas.</span></h1>
        <p class="page-lead">
          Des projets pour apprendre, expérimenter et transformer des idées
          en produits utilisables. Les captures et liens seront ajoutés au fil
          de leur avancement.
        </p>
      </section>

      <section class="project-grid">
        <article class="project-card project-featured">
          <div class="project-visual visual-moteo">
            <span class="visual-label">APPLICATION ANDROID</span>
            <span class="visual-symbol">⌁</span>
            <span class="visual-code">MOTÉO / 001</span>
          </div>

          <div class="project-details">
            <div class="project-meta">
              <span>01 — MOBILE</span>
              <span class="project-status">
                <i></i> En développement
              </span>
            </div>

            <h2>Motéo</h2>
            <p>
              Une application pensée pour les motards, avec un backend dédié
              et une approche centrée sur les alertes utiles pendant leurs trajets.
            </p>

            <div class="tech-list">
              <span>Kotlin</span>
              <span>Jetpack Compose</span>
              <span>Ktor</span>
            </div>

            <p class="project-note">
              Prochaine étape : ajouter des captures et préciser les fonctionnalités livrées.
            </p>
          </div>
        </article>

        <article class="project-card">
          <div class="project-visual visual-moble">
            <span class="visual-label">PLATEFORME WEB</span>
            <span class="visual-symbol">◫</span>
            <span class="visual-code">MOBLE / 002</span>
          </div>

          <div class="project-details">
            <div class="project-meta">
              <span>02 — FULLSTACK</span>
              <span class="project-status">
                <i></i> En évolution
              </span>
            </div>

            <h2>Moble</h2>
            <p>
              Une plateforme autour du mobilier vintage, développée pour
              pratiquer la création d’interfaces et la gestion de données.
            </p>

            <div class="tech-list">
              <span>React</span>
              <span>Express</span>
              <span>PostgreSQL</span>
              <span>Prisma</span>
            </div>

            <p class="project-note">Démonstration et dépôt à renseigner.</p>
          </div>
        </article>

        <article class="project-card">
          <div class="project-visual visual-lab">
            <span class="visual-label">PROJET DE FIN DE FORMATION</span>
            <span class="visual-symbol">&lbrace;&hellip;&rbrace;</span>
            <span class="visual-code">PROJECT / 003</span>
          </div>

          <div class="project-details">
            <div class="project-meta">
              <span>03 — WEB</span>
              <span class="project-status">
                <i></i> À construire
              </span>
            </div>

            <h2>Générateur de fiches JDR</h2>
            <p>
              Le projet fil rouge : créer un site qui accompagne les joueurs
              dans la création et l’organisation de personnages de jeu de rôle.
            </p>

            <div class="tech-list">
              <span>Fullstack</span>
              <span>UX</span>
              <span>À définir</span>
            </div>

            <a class="text-link" href="/blog/#projet-ecole">
              Suivre la conception <span>↗</span>
            </a>
          </div>
        </article>
      </section>

      <p class="portfolio-footnote">
        <span class="terminal-success">✓</span>
        Portfolio vivant : les projets évolueront avec le code, les tests et les retours.
      </p>
    </main>

    <Footer />
  </body>
</html>
